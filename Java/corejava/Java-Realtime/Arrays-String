Banking Transaction Summary
public class BankingTransactionSummary {

    public static void main(String[] args) {

        int[] transactions = {1000, -500, 2500, -800, 500, -300};

        int deposits = 0;
        int withdrawals = 0;
        int depositCount = 0;
        int withdrawalCount = 0;

        int largestDeposit = 0;
        int largestWithdrawal = 0;

        for (int amount : transactions) {

            if (amount > 0) {

                deposits += amount;
                depositCount++;

                if (amount > largestDeposit)
                    largestDeposit = amount;

            } else {

                withdrawals += Math.abs(amount);
                withdrawalCount++;

                if (Math.abs(amount) > largestWithdrawal)
                    largestWithdrawal = Math.abs(amount);
            }
        }

        int balance = deposits - withdrawals;

        System.out.println("Total Deposits     : ₹" + deposits);
        System.out.println("Total Withdrawals  : ₹" + withdrawals);
        System.out.println("Current Balance    : ₹" + balance);
        System.out.println("Deposits           : " + depositCount);
        System.out.println("Withdrawals        : " + withdrawalCount);
        System.out.println("Largest Deposit    : ₹" + largestDeposit);
        System.out.println("Largest Withdrawal : ₹" + largestWithdrawal);
    }
}

Output

Total Deposits     : ₹4000
Total Withdrawals  : ₹1600
Current Balance    : ₹2400
Deposits           : 3
Withdrawals        : 3
Largest Deposit    : ₹2500
Largest Withdrawal : ₹800



