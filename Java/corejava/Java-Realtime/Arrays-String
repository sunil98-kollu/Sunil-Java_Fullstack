5. Inventory Stock Management
public class InventoryStockManagement {

    public static void main(String[] args) {

        int[] stock = {25, 8, 0, 15, 5, 40};

        int total = 0;
        int highest = stock[0];
        int lowest = stock[0];

        int outOfStock = 0;
        int lowStock = 0;
        int highestProduct = 1;

        for (int i = 0; i < stock.length; i++) {

            total += stock[i];

            if (stock[i] == 0)
                outOfStock++;

            if (stock[i] < 10 && stock[i] > 0)
                lowStock++;

            if (stock[i] > highest) {

                highest = stock[i];
                highestProduct = i + 1;
            }

            if (stock[i] < lowest)
                lowest = stock[i];
        }

        System.out.println("Total Stock        : " + total);
        System.out.println("Out of Stock       : " + outOfStock);
        System.out.println("Low Stock          : " + lowStock);
        System.out.println("Highest Stock      : " + highest);
        System.out.println("Lowest Stock       : " + lowest);
        System.out.println("Highest Stock Item : Product " + highestProduct);
    }
}

Output

