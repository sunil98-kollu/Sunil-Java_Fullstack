//SavingsAccount that adds an interest rate and a method to calculate and display interest. 


package com.mad.inheritance;

public class SavingAccount extends BankAccount {
	
	    int interestRate = 3;
	    int tenure = 2;

	    public SavingAccount(int accNumber, String accHolder, double balance) {
	        super(accNumber, accHolder, balance);
	    }

	    void calculateInterest() {
	        double total = balance * interestRate * tenure / 100;
	        System.out.println("Interest Amount: " + total);
	        System.out.println("Total Balance after Interest: " + (balance + total));
	    }

	    public static void main(String[] args) {

	        SavingAccount sv = new SavingAccount(11, "Sunil", 10000);

	        sv.deposit(2000);
	        sv.calculateInterest();
	    }
}



