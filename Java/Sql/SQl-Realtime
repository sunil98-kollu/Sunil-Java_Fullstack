#5. Roll back to the SAVEPOINT after an incorrect update

START TRANSACTION;

SAVEPOINT BeforeUpdate;

UPDATE Account
SET Balance = Balance + 10000
WHERE AccountNo = 1003;

UPDATE Account
SET Balance = Balance - 50000
WHERE AccountNo = 1004;

ROLLBACK TO BeforeUpdate;

COMMIT;

#Result: The second update is undone. Changes before the savepoint are preserved.

